#!/bin/sh
# dot — run the dotfiles manager from anywhere, on any machine.
#   ln -s ~/dotfiles/dot ~/.local/bin/dot     then just:  dot
# Keeps its own private virtualenv so it never touches (or is broken by) the
# system Python, or whatever venv happens to be active in your shell.
set -e
self=$0
while [ -L "$self" ]; do                      # follow symlinks to the real repo
  dir=$(cd "$(dirname "$self")" && pwd)
  self=$(readlink "$self")
  case $self in /*) ;; *) self=$dir/$self ;; esac
done
repo=$(cd "$(dirname "$self")" && pwd)
venv=${XDG_DATA_HOME:-$HOME/.local/share}/dotfiles/venv

if [ ! -x "$venv/bin/python" ]; then
  # Pick a base interpreter outside any active venv
  base=
  for p in /opt/homebrew/bin/python3 /usr/local/bin/python3 /usr/bin/python3 python3; do
    command -v "$p" >/dev/null 2>&1 && { base=$p; break; }
  done
  [ -n "$base" ] || { echo "dot: python3 not found" >&2; exit 1; }
  echo "dot: first run, setting up $venv ..." >&2
  "$base" -m venv "$venv"
  "$venv/bin/python" -m pip install --quiet rich questionary tomli
fi
exec "$venv/bin/python" "$repo/dot.py" "$@"
