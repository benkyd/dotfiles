// Ported from ~/.vimrc and ~/.config/nvim. Leader is "," with Space as an alias, as in the vimrc; Zed has no leader
// key, so every leader binding is listed under both prefixes. Plugin bindings map to Zed's built-in equivalent:
// Telescope -> file finder / project search / tab switcher, Lspsaga -> editor LSP actions, gitsigns/diffview -> git,
// nvim-dap -> debugger, harpoon's ctrl-w N -> tab N, oil's ctrl-b -> project panel, zen-mode -> centred layout.
[
  {
    "context": "Workspace",
    "bindings": {
      "ctrl-b": "workspace::ToggleLeftDock"
    }
  },
  {
    "context": "Editor && vim_mode == normal && !menu",
    "bindings": {
      "g shift-d": "editor::GoToDefinition",
      "g d": "editor::GoToDefinition",
      "g shift-t": "editor::GoToTypeDefinition",
      "g t": "editor::GoToTypeDefinition",
      "g shift-r": "editor::FindAllReferences",
      "g r": "editor::FindAllReferences",
      "g i": "editor::GoToImplementation",
      "g n": "editor::GoToDiagnostic",
      "g shift-n": "editor::GoToPreviousDiagnostic",
      "g f": "editor::Format",
      "alt-enter": "editor::ToggleCodeActions",
      "ctrl-k": "editor::MoveLineUp",
      "ctrl-j": "editor::MoveLineDown",
      "shift-u": "vim::Redo",
      "ctrl-r": null,
      "ctrl-alt-h": "vim::ResizePaneLeft",
      "ctrl-alt-j": "vim::ResizePaneDown",
      "ctrl-alt-k": "vim::ResizePaneUp",
      "ctrl-alt-l": "vim::ResizePaneRight",
      "ctrl-w 1": [
        "pane::ActivateItem",
        0
      ],
      "ctrl-w 2": [
        "pane::ActivateItem",
        1
      ],
      "ctrl-w 3": [
        "pane::ActivateItem",
        2
      ],
      "ctrl-w 4": [
        "pane::ActivateItem",
        3
      ],
      "ctrl-w 5": [
        "pane::ActivateItem",
        4
      ],
      "ctrl-w 6": [
        "pane::ActivateItem",
        5
      ],
      "ctrl-w 7": [
        "pane::ActivateItem",
        6
      ],
      "ctrl-w 8": [
        "pane::ActivateItem",
        7
      ],
      "ctrl-w 9": [
        "pane::ActivateItem",
        8
      ],
      ", f f": "file_finder::Toggle",
      ", f g": "pane::DeploySearch",
      ", f b": "tab_switcher::Toggle",
      ", r": "vim::ToggleRegistersView",
      ", m": "vim::ToggleMarksView",
      ", p": [
        "workspace::SendKeystrokes",
        "\" _ d shift-p"
      ],
      ", c c": "editor::ToggleComments",
      ", g b": "editor::ToggleGitBlameInline",
      ", g d": "git::Diff",
      ", g h": "git::FileHistory",
      ", g q": "pane::CloseActiveItem",
      ", g r": "editor::Rename",
      ", g g": "editor::SwitchSourceHeader",
      ", x": "editor::ToggleInlineDiagnostics",
      ", z": "workspace::ToggleCenteredLayout",
      ", t t": "theme_selector::Toggle",
      ", d b": "editor::ToggleBreakpoint",
      ", d s": "debugger::Start",
      ", d c": "debugger::Continue",
      ", d n": "debugger::StepOver",
      ", d i": "debugger::StepInto",
      ", d o": "debugger::StepOut",
      ", d e": "debugger::Stop",
      ", shift-d shift-c": "debugger::ClearAllBreakpoints",
      "space f f": "file_finder::Toggle",
      "space f g": "pane::DeploySearch",
      "space f b": "tab_switcher::Toggle",
      "space r": "vim::ToggleRegistersView",
      "space m": "vim::ToggleMarksView",
      "space p": [
        "workspace::SendKeystrokes",
        "\" _ d shift-p"
      ],
      "space c c": "editor::ToggleComments",
      "space g b": "editor::ToggleGitBlameInline",
      "space g d": "git::Diff",
      "space g h": "git::FileHistory",
      "space g q": "pane::CloseActiveItem",
      "space g r": "editor::Rename",
      "space g g": "editor::SwitchSourceHeader",
      "space x": "editor::ToggleInlineDiagnostics",
      "space z": "workspace::ToggleCenteredLayout",
      "space t t": "theme_selector::Toggle",
      "space d b": "editor::ToggleBreakpoint",
      "space d s": "debugger::Start",
      "space d c": "debugger::Continue",
      "space d n": "debugger::StepOver",
      "space d i": "debugger::StepInto",
      "space d o": "debugger::StepOut",
      "space d e": "debugger::Stop",
      "space shift-d shift-c": "debugger::ClearAllBreakpoints"
    }
  },
  {
    "context": "Editor && vim_mode == visual && !menu",
    "bindings": {
      "ctrl-k": "editor::MoveLineUp",
      "ctrl-j": "editor::MoveLineDown",
      ", c c": "editor::ToggleComments",
      "space c c": "editor::ToggleComments"
    }
  },
  {
    "context": "Editor && vim_mode == insert",
    "bindings": {
      "ctrl-v": "editor::Paste"
    }
  }
]
