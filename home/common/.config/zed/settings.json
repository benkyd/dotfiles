// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
  "session": {
    "trust_all_worktrees": true
  },
  "base_keymap": "Zed",
  "vim_mode": true,
  // The rest mirrors ~/.vimrc; keymap.json has the bindings.
  "vim": {
    "use_system_clipboard": "always", // clipboard=unnamedplus
    "use_smartcase_find": true, // ignorecase + smartcase
    "toggle_relative_line_numbers": true // relative in normal mode, absolute in insert
  },
  "vertical_scroll_margin": 4, // scrolloff=4
  "tab_size": 4,
  "hard_tabs": false, // expandtab
  "soft_wrap": "editor_width", // wrap
  "ui_font_size": 16,
  "buffer_font_size": 15,
  "theme": {
    "mode": "system",
    "light": "One Light",
    "dark": "Ayu Dark",
  },
}
